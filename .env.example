# ===== FREE stack (default) =====
GEMINI_API_KEY=...          # free at https://aistudio.google.com/app/apikey
# edge-tts + Pollinations images need NO key.

# ===== Premium stack (optional upgrades) =====
OPENAI_API_KEY=sk-...       # used if providers.llm.provider=openai
ELEVENLABS_API_KEY=sk_...   # used if providers.tts.provider=elevenlabs
FAL_KEY=...                 # used if providers.video.provider=kling
RUNWAY_API_KEY=             # used if providers.video.provider=runway

# YouTube upload (fill after OAuth walkthrough; see README)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ===== Instagram auto-poster =====
IG_USER_ID=                 # Instagram Business Account ID (numeric)
META_APP_ID=                # Meta Developer App ID
META_LONG_LIVED_TOKEN=      # 60-day Page access token
# Public HTTPS base for ig_content/ folder. On GitHub Actions this is set
# automatically to https://raw.githubusercontent.com/<repo>/<branch>/ig_content
PUBLIC_MEDIA_BASE_URL=
WEBHOOK_VERIFY_TOKEN=       # only needed if you run the /webhook server
