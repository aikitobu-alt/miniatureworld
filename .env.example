# ===== FREE stack (default) =====
GEMINI_API_KEY=...          # free at https://aistudio.google.com/app/apikey
# edge-tts + Pollinations images need NO key.

# ===== Premium stack (optional upgrades) =====
OPENAI_API_KEY=sk-...       # used if providers.llm.provider=openai
ELEVENLABS_API_KEY=sk_...   # used if providers.tts.provider=elevenlabs
FAL_KEY=...                 # used if providers.video.provider=kling
RUNWAY_API_KEY=             # used if providers.video.provider=runway

# YouTube upload (fill after OAuth walkthrough; see README)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
